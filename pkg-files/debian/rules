#!/usr/bin/make -f

MODULE = aorus-laptop
# Upstream version without the Debian revision, as postinst and prerm use it
VERSION = $(shell dpkg-parsechangelog | sed -n 's/^Version: //p' | cut -d- -f1)
%:
	dh $@ --parallel --with dkms

override_dh_install:
	cp ../dkms.conf .
	sed -i dkms.conf -e "s/@PKGVER@/$(VERSION)/"
	dh_install dkms.conf ../Makefile ../README.md ../aorus-laptop.c usr/src/$(MODULE)-$(VERSION)/
	dh_install ../aorus-laptop.conf usr/lib/modules-load.d/
	rm dkms.conf

override_dh_dkms:
	dh_dkms -V $(VERSION)

override_dh_builddeb:
	dh_builddeb -- -Zxz