#!/bin/sh

NAME=aorus-laptop
PKGNAME=$NAME-dkms
VERSION=$(dpkg-query -W -f='${Version}' $PKGNAME | awk -F "-" '{print $1}' | cut -d\: -f2)

set -e

case "$1" in
    remove|upgrade|deconfigure)
        if [ "`dkms status -m $NAME -v $VERSION`" ]; then
            dkms remove -m $NAME -v $VERSION --all
        fi
    ;;
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0